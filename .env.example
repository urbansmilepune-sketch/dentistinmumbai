# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored — never commit secrets.

# Supabase ---------------------------------------------------------------
# Project URL and the public anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key bypasses RLS. SERVER ONLY — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (Gold upgrade payments) ---------------------------------------
# Test keys start with rzp_test_, live keys with rzp_live_.
# Get keys from: Razorpay Dashboard → Settings → API Keys → Generate Key.
#
# To add to Vercel:
#   1. vercel.com → your project → Settings → Environment Variables
#   2. Add RAZORPAY_KEY_ID — apply to Production, Preview, Development
#   3. Add RAZORPAY_KEY_SECRET — same scope; mark as Sensitive so it's
#      hidden from the dashboard after save
#   4. Redeploy (env-var changes don't take effect until next deploy)
# Or via CLI:
#   vercel env add RAZORPAY_KEY_ID
#   vercel env add RAZORPAY_KEY_SECRET
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# MSG91 (WhatsApp/SMS for booking notifications, OTPs) -------------------
# Without MSG91_AUTH_KEY the booking notifier and OTP sender fall back to console logs.
MSG91_AUTH_KEY=
MSG91_BOOKING_TEMPLATE_ID=
MSG91_OTP_TEMPLATE_ID=

# Cloudinary (image uploads — clinic photos, x-rays) ---------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (transactional email) -------------------------------------------
RESEND_API_KEY=

# WATI (alternate WhatsApp provider — currently referenced but optional) -
WATI_API_KEY=
