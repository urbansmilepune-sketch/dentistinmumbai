# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local one-off scratch (raw geojson downloads etc.)
/tmp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

.env*.local

# local scratch files & scraped data dumps (not part of the app)
*.xlsx
scrape_*.py
/test.txt
/wwww.txt
src/lib/*.txt

# generated outreach reports — contain PII, regenerate with scripts/segment_dentists.py
dentist-outreach-segments.csv
dentist-blank-fees.csv
